{
  "camera": {
    "index": 0,
    "width": 1280,
    "height": 720,
    "fps": 30,
    "backend": "auto",
    "mirror": false
  },
  "paths": {
    "hoop_calibration": "calibration_data/hoop.json",
    "ball_model": "calibration_data/ball_model.json",
    "ball_samples_dir": "calibration_data/ball_samples",
    "logs_dir": "logs",
    "recordings_dir": "recordings"
  },
  "ball": {
    "_comment": "Built-in profile of your ball (cream/black cloth basketball) so it is recognised before ball calibration; your own calibration (B) is added on top. room_learning teaches the model what your room looks like while it runs.",
    "profile": "models/ball_profiles/veidoorn_cream_black.json",
    "use_profile": true,
    "profile_with_calibration": true,
    "room_learning": true,
    "room_learning_start_s": 1.5,
    "room_learning_interval_s": 6.0,
    "room_learning_patches_per_frame": 6
  },
  "geometry": {
    "_comment": "Real sizes are only used for the initial guess of how big the ball looks at the rim; HoopVision then learns it from your own makes.",
    "rim_inner_diameter_cm": 23.0,
    "ball_diameter_cm": 17.0,
    "rim_depth_radius_tolerance": [
      0.6,
      1.3
    ]
  },
  "detector": {
    "global_width": 640,
    "mog2_history": 300,
    "mog2_var_threshold": 24,
    "mog2_learning_rate": -1,
    "min_blob_area_px": 30,
    "motion_min_fill": 0.35,
    "max_blob_aspect": 2.2,
    "hough_param1": 90,
    "hough_param2": 22,
    "hoop_roi_scale": 1.8,
    "hoop_roi_upscale_below_px": 220,
    "init_score": 0.4,
    "track_score": 0.33,
    "track_min_motion_evidence": 0.25,
    "track_min_appearance_evidence": 0.3,
    "track_size_jump_min_appearance": 0.5,
    "min_motion_for_init": 0.2,
    "min_appearance_for_init": 0.2,
    "static_circle_seconds": 2.0,
    "weights_init": {
      "appearance": 0.45,
      "motion": 0.3,
      "shape": 0.15,
      "detector": 0.1
    },
    "weights_track": {
      "appearance": 0.3,
      "motion": 0.2,
      "shape": 0.1,
      "detector": 0.05,
      "size": 0.15,
      "gate": 0.2
    },
    "onnx": {
      "enabled": false,
      "_comment": "The generic COCO models do NOT detect this ball (see docs/DIAGNOSIS.md). Enable only with a custom model trained on your ball.",
      "model_path": "models/ball_custom.onnx",
      "format": "yolov8",
      "input_size": 640,
      "num_classes": 1,
      "ball_class_ids": [
        0
      ],
      "min_score": 0.15,
      "every_n_frames": 2
    },
    "max_streak_aspect": 6.0
  },
  "tracker": {
    "confirm_hits": 3,
    "max_tentative": 4,
    "max_coast_s": 0.5,
    "max_coast_out_of_frame_s": 1.2,
    "accel_noise": 4000.0,
    "gate_sigma": 4.0,
    "max_speed_px_s": 6000.0,
    "max_accel_px_s2": 30000.0,
    "radius_change_per_s": 4.0,
    "history_s": 4.0
  },
  "shot": {
    "_comment": "Image-space, scale-normalised thresholds. 'depth' cues come from the ball shrinking as it flies away from the camera.",
    "min_window_obs": 3,
    "max_window_s": 0.6,
    "away_rate_per_s": 1.4,
    "min_shrink_ratio": 0.85,
    "min_speed_rim_widths_s": 1.5,
    "min_toward_rim_cos": 0.3,
    "side_view_min_approach": 0.8,
    "rearm_radius_factor": 1.6,
    "rearm_timeout_s": 2.0,
    "cooldown_s": 0.7,
    "pending_max_s": 0.6,
    "pending_reverse_ratio": 1.15,
    "confirm_shrink_ratio": 0.62,
    "top_exit_min_speed_rim_widths_s": 8.0,
    "top_exit_max_offset_frac": 0.35,
    "top_exit_window_s": 0.5,
    "min_window_obs_fraction": 0.5,
    "rebound_fall_speed_rim_w_s": 4.0,
    "min_track_age_s": 0.25,
    "hands_to_hoop_max_s": 1.6,
    "hoop_fallback_max_size": 1.9
  },
  "outcome": {
    "max_crossing_gap_s": 0.45,
    "opening_margin": 0.92,
    "settle_s": 0.35,
    "timeout_s": 4.0,
    "lost_wait_s": 1.0,
    "make_threshold": 0.65,
    "fall_check_s": 0.3,
    "free_fall_ratio": 0.9,
    "front_size_ratio": 1.06,
    "front_size_ratio_hard": 1.12,
    "net_motion_threshold": 0.04,
    "learn_ratio": true,
    "buffer_s": 3.0
  },
  "audio": {
    "enabled": true,
    "volume": 0.6
  },
  "ui": {
    "window_name": "HoopVision",
    "show_debug": false,
    "scoreboard_scale": 1.0,
    "notification_s": 1.5
  }
}